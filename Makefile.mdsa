###
# Build specification docs
#
### Basic use: 'make'
# A build/ directory will be created if not already present, and all necessary files for producing the specification PDF will be copied or generated into there.
#
### Debugging: `make debug`
# This will show the output of the LaTeX build to help debug
#
### Generating from a model
# If a file named <SPECACRO>.config is present in this dirctory, it will be used to drive md2LaTeX.py from the mdsa-tools
# repository, and generate LaTeX files from a MagicDraw model. (Other tool support pending.) Otherwise, this step
# is skipped.

### Author settable locations
# IF you are building using a local LaTeX install, uncomment these lines, and set appropriately.
# If you are using the Docker container engine, leave them commented, it's handled internally.
# Default directory for temporary files while building your PDF
#build := ./build
# Where to find your source files - almost certainly this directory
#source := .

# Where you GeneratedContent will be placed from your model if you're using that mechanism
gencondir := GeneratedContent

### Final PDF name
# By default, it is simply the ACRONYM_VERSION.pdf. 
# If you choose to use something different, comment the following line and set pdfnamebase to a new value.
pdfnamebase = ${specacro}_${version}

###
# Nothing below here is user settable or usable
doc := Specification
all: spec
.PHONY: all 
include ./mdsa-omg-core/_core.mk

# DMN: to give the PDF the pages of the Word PDF of DMN 1.7 Beta 1 (for a
# page-by-page comparison with it), uncomment these lines: specification.lua then
# starts pages where tools/dmn-pages.txt says. Only for the Markdown as converted
# from Word; after edits, the pages no longer match.
#$(subst ${source}/,${build}/,$(subst .md,.tex,${markdowns})): ${build}/dmn-pages.txt
#${build}/dmn-pages.txt: ${source}/tools/dmn-pages.txt ; mkdir -p "${build}" && cp $< $@
